{
  "pluginAlias": "PuraSmartDiffuser",
  "pluginType": "platform",
  "singular": true,
  "x-branding": {
    "imagePath": "branding/banner.png",
    "iconPath": "branding/icon.png",
    "image": "https://raw.githubusercontent.com/homebridge-plugins/homebridge-pura/latest/branding/banner.png",
    "icon": "https://raw.githubusercontent.com/homebridge-plugins/homebridge-pura/latest/branding/icon.png"
  },
  "x-icon": "branding/icon.png",
  "icon": "https://raw.githubusercontent.com/homebridge-plugins/homebridge-pura/latest/branding/icon.png",
  "headerDisplay": "![Pura Smart Diffuser](https://raw.githubusercontent.com/homebridge-plugins/homebridge-pura/latest/branding/banner.png)",
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "username",
      "password"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Pura Smart Diffuser"
      },
      "username": {
        "title": "Username",
        "type": "string",
        "description": "Your Pura app username (email address)"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "description": "Your Pura app password"
      },
      "forceNightlightOff": {
        "title": "Force Nightlight Off",
        "type": "boolean",
        "default": false,
        "description": "Pura turns the nightlight on/off with the diffuser. If enabled, the plugin will send a nightlight off command right after turning on a diffuser."
      }
    }
  }
}
